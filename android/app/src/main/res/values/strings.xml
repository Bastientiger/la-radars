    <string name="info">Fines &amp; rules</string>
    <string name="info_title">Fines &amp; rules</string>
    <string name="info_status_line">Today: %1$d cameras live, %2$d still under construction. LADOT plans to have all 125 running by the end of 2026; this app refreshes the list from LADOT every day.</string>
    <string name="info_fines_title">Fine per violation (California AB 645)</string>
    <string name="fine_tier1_over">11 to 15 mph over the limit</string>
    <string name="fine_tier1_amount">$50</string>
    <string name="fine_tier1_note">The first time a vehicle is caught in this band, it only gets a warning.</string>
    <string name="fine_tier2_over">16 to 25 mph over</string>
    <string name="fine_tier2_amount">$100</string>
    <string name="fine_tier3_over">26 mph or more over</string>
    <string name="fine_tier3_amount">$200</string>
    <string name="fine_tier4_over">100 mph or faster</string>
    <string name="fine_tier4_amount">$500</string>
    <string name="info_fines_body">Below 11 mph over the limit, the camera does nothing. The fine is a civil penalty: no points on your licence, no effect on insurance, and it is not a criminal offence.</string>
    <string name="info_warning_title">60-day warning period</string>
    <string name="info_warning_body">Every camera starts with 60 days of warnings only: a notice in the mail, no fine. The first cameras went live on October 26, 2026, so their fines begin December 26, 2026. Each camera activated later gets its own 60-day warning period. Cameras shown as \"Live\" in this app may still be in that period.</string>
    <string name="info_who_title">Who receives the notice</string>
    <string name="info_who_body">The camera photographs the licence plate; the notice is mailed to the registered owner of the vehicle, whoever was driving. It can be contested, and the owner can name the actual driver.</string>
    <string name="info_reduction_title">Reduced fines</string>
    <string name="info_reduction_body">Drivers with income below 250% of the federal poverty level can get the fine reduced by 50% to 80%, or do community service instead. Payment plans are available.</string>
    <string name="info_program_title">The program</string>
    <string name="info_program_body">The Speed Safety System is a five-year pilot run by LADOT under state law AB 645, at 125 locations chosen for their crash and speeding history, with 8 or 9 in each council district. Revenue goes to street safety improvements.</string>
    <string name="info_ladot_link">Official LADOT page</string>
    <string name="info_disclaimer">Summary for information only, from the AB 645 text and LADOT publications. The official notice and LADOT page prevail.</string>
